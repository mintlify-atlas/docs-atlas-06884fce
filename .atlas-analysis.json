  "keyFeatures": [
    "79 Chromium enterprise policies across 7 categories",
    "6 built-in presets: Maximum Privacy, Balanced Privacy, Performance Focused, Developer, Strict Parental Controls, Brave Origin",
    "Curses TUI on Linux/macOS with collapsible categories, live counts, /search, and description pane",
    "Native Windows GUI with sidebar, search (reads descriptions), keyboard navigation, and preset cards",
    "CLI mode (--import, --export, --reset) for scripting and automation on Linux/macOS",
    "DNS-over-HTTPS management with custom template URL support",
    "Multi-channel support: Stable, Beta, Nightly, Dev, and Brave Origin",
    "macOS Configuration Profile support (--persist on) for durable policies across reboots",
    "Cross-platform import/export: JSON configs round-trip between all three scripts",
    "Zero dependencies — Python 3 stdlib only on Linux/macOS; PowerShell 5.1 on Windows"
  ],
  "publicApiSurface": [
    "sudo python3 slimbrave-linux.py (TUI)",
    "sudo python3 slimbrave-linux.py --import PATH",
    "sudo python3 slimbrave-linux.py --export PATH",
    "sudo python3 slimbrave-linux.py --reset",
    "sudo python3 slimbrave-linux.py --policy-file PATH",
    "sudo python3 slimbrave-linux.py --doh-templates URL",
    "sudo python3 slimbrave-linux.py --channels LIST",
    "sudo python3 slimbrave-mac.py (TUI)",
    "sudo python3 slimbrave-mac.py --import PATH",
    "sudo python3 slimbrave-mac.py --export PATH",
    "sudo python3 slimbrave-mac.py --reset",
    "sudo python3 slimbrave-mac.py --persist on|off",
    "sudo python3 slimbrave-mac.py --channels stable,beta,nightly",
    "powershell -ExecutionPolicy Bypass -File .\\SlimBrave.ps1 (GUI)",
    "Presets/Maximum Privacy Preset.json",
    "Presets/Balanced Privacy Preset.json",
    "Presets/Performance Focused Preset.json",
    "Presets/Developer Preset.json",
    "Presets/Strict Parental Controls Preset.json",
    "Presets/Brave Origin Preset.json"
  ]
